# ==============================================================================
# CodeOrbit Backend Environment Variables Template
# Copy this file to .env or export these variables in your environment.
# DO NOT commit real secrets, production passwords, or sensitive keys to Git.
# ==============================================================================

# Server Port
PORT=8080

# Active Spring Profile: 'dev' (H2 in-memory) or 'mysql' (MySQL codeorbit_db)
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codeorbit_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JPA Settings
JPA_DDL_AUTO=update
SHOW_SQL=false

# CORS Allowed Origins (Comma-separated list of allowed frontend dev origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Demo Seed Data (Populate sample e-books if database is empty; false in production)
SEED_DEMO_DATA=true
