# =================================================================
# CodeOrbit - Production Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root: cp .env.example .env
# 2. Fill in all REQUIRED values with secure production credentials.
# 3. NEVER commit the actual '.env' file to version control.
# =================================================================

# -------------------------------------------------------------
# 1. Server & Profile Settings
# -------------------------------------------------------------
# Public HTTP port mapped to host by Nginx (default: 80)
PORT=80
# Spring Boot profiles: strictly 'prod,mysql' for production deployment
SPRING_PROFILES_ACTIVE=prod,mysql

# -------------------------------------------------------------
# 2. Database Configuration (MySQL 8.0)
# -------------------------------------------------------------
# Internal Docker host name is 'mysql'. For external managed RDS/CloudSQL, provide IP/hostname.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=codeorbit_db
DB_USER=codeorbit_user
# REQUIRED: Strong database passwords (minimum 16+ alphanumeric/symbols)
DB_PASSWORD=replace_with_strong_db_user_password
DB_ROOT_PASSWORD=replace_with_strong_db_root_password

# -------------------------------------------------------------
# 3. Database Migration & Schema Validation
# -------------------------------------------------------------
# Flyway migration execution (true for automatic schema migration on startup)
FLYWAY_ENABLED=true
# Baselining policy: strictly 'false' for fresh databases.
# Set to 'true' with FLYWAY_BASELINE_VERSION=1 ONLY when initializing Flyway on an existing verified database.
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1
# JPA / Hibernate schema mode: strictly 'validate' in production. Never use 'update' or 'create'.
JPA_DDL_AUTO=validate

# -------------------------------------------------------------
# 4. JWT Authentication & Security
# -------------------------------------------------------------
# REQUIRED: Cryptographically random HMAC-SHA256 secret (minimum 256-bit / 32+ characters).
# In 'prod' profile, startup will fail immediately if this is left default or empty.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_cryptographically_secure_256_bit_secret_key_minimum_32_chars
# Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS)
# -------------------------------------------------------------
# Comma-separated list of allowed origin domains.
# Do NOT use '*' in production. Set to your exact production domain(s).
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -------------------------------------------------------------
# 6. Admin User Bootstrap (Initial Setup Only)
# -------------------------------------------------------------
# Enable to bootstrap initial Store Admin on first startup if no admin account exists.
# Once initial admin is created, this can be set to false.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_admin_password_16_chars
ADMIN_BOOTSTRAP_NAME=CodeOrbit Academy Admin

# -------------------------------------------------------------
# 7. File Storage & Frontend
# -------------------------------------------------------------
# Path inside backend container mounted to persistent Docker volume 'pdf_storage'
PRIVATE_PDF_STORAGE_PATH=/app/storage/private/pdfs
# Frontend API base URL (defaults to '/api' for same-origin Nginx reverse proxy)
VITE_API_BASE_URL=/api

